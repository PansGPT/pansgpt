# ==============================================================================
# PansGPT 2.0 FastAPI Core Engine Environment Configuration (.env)
# ==============================================================================
ENVIRONMENT=development
PROJECT_NAME="PansGPT 2.0 Core Engine"
API_V1_PREFIX=/api/v1

# CORS
ALLOWED_ORIGINS=["http://localhost:3000","https://pansgpt.com","https://staging.pansgpt.com"]

# Database & Supabase
DATABASE_URL=postgresql://postgres.nrzbjhqtcxlfiyvoeanb:YOUR_PASSWORD@aws-1-eu-west-1.pooler.supabase.com:5432/postgres
SUPABASE_URL=https://nrzbjhqtcxlfiyvoeanb.supabase.co
SUPABASE_ANON_KEY=YOUR_SUPABASE_ANON_KEY
SUPABASE_SERVICE_ROLE_KEY=YOUR_SUPABASE_SERVICE_ROLE_KEY
SUPABASE_JWT_SECRET=YOUR_SUPABASE_JWT_SECRET

# Cloudflare R2 (PDF monographs & cropped note storage)
R2_ACCOUNT_ID=YOUR_R2_ACCOUNT_ID
R2_ACCESS_KEY_ID=YOUR_R2_ACCESS_KEY_ID
R2_SECRET_ACCESS_KEY=YOUR_R2_SECRET_ACCESS_KEY
R2_BUCKET_NAME=pansgpt-documents-staging
R2_PUBLIC_DOMAIN=https://documents-staging.pansgpt.com

# AI / LLM Providers ($0 Free Tier)
GEMINI_API_KEY=YOUR_GOOGLE_AI_STUDIO_API_KEY
GEMINI_PRIMARY_MODEL=gemma-4-31b-it
GEMINI_EMBEDDING_MODEL=gemini-embedding-002
GROQ_API_KEY=YOUR_GROQ_API_KEY
GROQ_FALLBACK_MODEL=llama-3.3-70b-versatile
OPENROUTER_API_KEY=YOUR_OPENROUTER_API_KEY

# Upstash Redis & Background Worker Queue
REDIS_URL=rediss://default:YOUR_TOKEN@YOUR_HOST.upstash.io:6379
UPSTASH_REDIS_REST_URL=https://YOUR_HOST.upstash.io
UPSTASH_REDIS_REST_TOKEN=YOUR_UPSTASH_TOKEN

# Transactional Email (Resend)
RESEND_API_KEY=re_YOUR_RESEND_KEY
EMAIL_FROM="PansGPT <support@pansgpt.com>"

# Billing (Paystack & Flutterwave)
PAYSTACK_SECRET_KEY=sk_test_YOUR_PAYSTACK_SECRET
FLUTTERWAVE_SECRET_KEY=FLWSECK_TEST-YOUR_FLUTTERWAVE_SECRET

# Observability
SENTRY_DSN=https://YOUR_KEY@sentry.io/PROJECT_ID
