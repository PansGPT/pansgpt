# ==============================================================================
# PansGPT 2.0 FastAPI Core Engine Environment Configuration (.env)
# ==============================================================================
ENVIRONMENT=development
PROJECT_NAME="PansGPT 2.0 Core Engine"
API_V1_PREFIX=/api/v1
# Enable only after the quiz lifecycle migration and worker are deployed.
ENABLE_QUIZ=false
# Opt-in only: background inventory shares the daily provider budget with students.
ENABLE_QUIZ_INVENTORY=false

# CORS
ALLOWED_ORIGINS=["http://localhost:3000","https://pansgpt.com","https://staging.pansgpt.com"]

# Database & Supabase
DATABASE_URL=postgresql://postgres.nrzbjhqtcxlfiyvoeanb:YOUR_PASSWORD@aws-1-eu-west-1.pooler.supabase.com:5432/postgres
SUPABASE_URL=https://nrzbjhqtcxlfiyvoeanb.supabase.co
SUPABASE_ANON_KEY=YOUR_SUPABASE_ANON_KEY
SUPABASE_SERVICE_ROLE_KEY=YOUR_SUPABASE_SERVICE_ROLE_KEY
SUPABASE_JWT_SECRET=YOUR_SUPABASE_JWT_SECRET

# Cloudflare R2 (PDF monographs & cropped note storage)
R2_ACCOUNT_ID=YOUR_R2_ACCOUNT_ID
R2_ACCESS_KEY_ID=YOUR_R2_ACCESS_KEY_ID
R2_SECRET_ACCESS_KEY=YOUR_R2_SECRET_ACCESS_KEY
R2_BUCKET_NAME=pansgpt-documents-staging
R2_PUBLIC_DOMAIN=https://documents-staging.pansgpt.com
SOFFICE_PATH=  # [OFFICE PDF FIX]

# Client Application Secret Headers (x-api-key)
X_API_KEY_WEB=YOUR_X_API_KEY_WEB
X_API_KEY_MOBILE=YOUR_X_API_KEY_MOBILE
X_API_KEY_DESKTOP=YOUR_X_API_KEY_DESKTOP

# AI / LLM Providers ($0 Free Tier)
GEMINI_API_KEY=YOUR_GOOGLE_AI_STUDIO_API_KEY
# Semantic route-or-answer budget (shared across provider fallback attempts)
INTENT_ROUTER_TOTAL_TIMEOUT_S=12
INTENT_ROUTER_ATTEMPT_TIMEOUT_S=8
INTENT_ROUTER_MAX_TOKENS=768
CHAT_RETRIEVAL_TIMEOUT_S=25
GEMINI_PRIMARY_MODEL=gemma-4-31b-it
GEMINI_SECONDARY_MODEL=gemma-4-26b-a4b-it
GEMINI_VISION_MODEL=gemma-4-26b-a4b-it  # [VISION FIX]
GEMINI_EMBEDDING_MODEL=gemini-embedding-2  # [EMBED FIX]
GEMINI_EMBEDDING_DIMENSIONS=1536  # [DIM 1536]
EMBEDDER_FAKE_MODE=false  # [EMBED FIX]
VISION_FAKE_MODE=false  # [IMAGE FIX]
VISION_MAX_OUTPUT_TOKENS=1024  # [PHASE2 FIX]
GROQ_API_KEY=YOUR_GROQ_API_KEY
GROQ_FALLBACK_MODEL=llama-3.3-70b-versatile
OPENROUTER_API_KEY=YOUR_OPENROUTER_API_KEY
OPENROUTER_FALLBACK_MODEL=nvidia/nemotron-3-ultra-550b-a55b:free

# Search Tool Integration
TAVILY_API_KEY=tvly-YOUR_TAVILY_API_KEY

# Upstash Redis & Background Worker Queue
REDIS_URL=rediss://default:YOUR_TOKEN@YOUR_HOST.upstash.io:6379
UPSTASH_REDIS_URL=rediss://default:YOUR_TOKEN@YOUR_HOST.upstash.io:6379
UPSTASH_REDIS_REST_URL=https://YOUR_HOST.upstash.io
UPSTASH_REDIS_REST_TOKEN=YOUR_UPSTASH_TOKEN

# Transactional Email (Resend)
RESEND_API_KEY=re_YOUR_RESEND_KEY
EMAIL_FROM="PansGPT <support@pansgpt.com>"

# Billing (Paystack & Flutterwave)
PAYSTACK_SECRET_KEY=sk_test_YOUR_PAYSTACK_SECRET
PAYSTACK_WEBHOOK_SECRET=YOUR_PAYSTACK_WEBHOOK_SECRET
FLUTTERWAVE_SECRET_KEY=FLWSECK_TEST-YOUR_FLUTTERWAVE_SECRET
FLUTTERWAVE_WEBHOOK_SECRET=YOUR_FLUTTERWAVE_WEBHOOK_SECRET

# Observability
SENTRY_DSN=https://YOUR_KEY@sentry.io/PROJECT_ID

# Google/Gemini is allowed without ZDR by user-approved policy; free-tier content may be retained,
# human-reviewed and used for product improvement. See docs/provider-privacy.md.
# Other providers require verified ZDR. Set true only after recording account/policy evidence.
GROQ_ZDR_CONFIRMED=false
OPENROUTER_ZDR_CONFIRMED=false
OPENAI_ZDR_CONFIRMED=false
TAVILY_ZDR_CONFIRMED=false
# Separate public-query retention exception; never label it verified Tavily ZDR.
TAVILY_PUBLIC_SEARCH_ALLOWED=false
AI_REQUEST_TIMEZONE=Africa/Lagos
COHERE_ZDR_CONFIRMED=false
ENABLE_AI=true
ENABLE_INGESTION=true

# Shared text-provider capacity and quiz-bank coordination. Application ceilings
# can be overridden with AI_PROVIDER_BUDGETS JSON after verifying account limits.
AI_CAPACITY_ENABLED=true
AI_CAPACITY_SCOPE=pansgpt
