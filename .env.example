# ==============================================================================
# PansGPT 2.0 Environment Configuration Template
# Copy to .env in local dev. Never commit actual secret keys to git.
# ==============================================================================

# --- Application Environment ---
ENVIRONMENT=development                # development | staging | production
NEXT_PUBLIC_APP_URL=http://localhost:3000
API_BASE_URL=http://localhost:8000
NEXT_PUBLIC_API_URL=http://localhost:8000

# --- Supabase (Auth, Postgres DB, Realtime) ---
SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your-supabase-anon-key
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key
SUPABASE_JWT_SECRET=your-supabase-jwt-secret
DATABASE_URL=postgresql://postgres:password@localhost:54322/postgres

# --- Cloudflare R2 (PDF Document Storage) ---
R2_ACCOUNT_ID=your-cloudflare-account-id
R2_ACCESS_KEY_ID=your-r2-access-key-id
R2_SECRET_ACCESS_KEY=your-r2-secret-access-key
R2_BUCKET_NAME=pansgpt-documents
R2_PUBLIC_DOMAIN=https://documents.pansgpt.com

# --- Client Application Secret Headers (x-api-key) ---
X_API_KEY_WEB=your_x_api_key_web
X_API_KEY_MOBILE=your_x_api_key_mobile
X_API_KEY_DESKTOP=your_x_api_key_desktop

# --- AI & LLM Engine ---
# Primary Engine: Google Gemini / Gemma 4 via Google AI Studio ($0 Free Tier)
GEMINI_API_KEY=your-google-ai-studio-api-key
GEMINI_PRIMARY_MODEL=gemma-4-31b-it
GEMINI_SECONDARY_MODEL=gemma-4-26b-a4b-it
GEMINI_EMBEDDING_MODEL=gemini-embedding-002
GEMINI_EMBEDDING_DIMENSIONS=3072

# Fast Fallback Engine: Groq ($0 Free Tier)
GROQ_API_KEY=your-groq-api-key
GROQ_FALLBACK_MODEL=openai/gpt-oss-120b

# Safety-Net Engine: OpenRouter ($0 Free Tier fallback)
OPENROUTER_API_KEY=your-openrouter-api-key
OPENROUTER_FALLBACK_MODEL=google/gemma-2-27b-it

# Search Tool Integration
TAVILY_API_KEY=tvly-your_tavily_api_key

# --- Redis Cache & ARQ Background Workers (Upstash Serverless Redis) ---
UPSTASH_REDIS_REST_URL=https://your-redis.upstash.io
UPSTASH_REDIS_REST_TOKEN=your-upstash-redis-token
REDIS_URL=rediss://default:your-token@your-redis.upstash.io:6379
UPSTASH_REDIS_URL=rediss://default:your-token@your-redis.upstash.io:6379

# --- Transactional Email (Resend — 3,000 free emails/mo) ---
RESEND_API_KEY=re_your_resend_api_key
EMAIL_FROM="PansGPT <support@pansgpt.com>"

# --- Payments (Paystack & Flutterwave) ---
PAYSTACK_SECRET_KEY=sk_test_your_paystack_secret
PAYSTACK_WEBHOOK_SECRET=your_paystack_webhook_secret
NEXT_PUBLIC_PAYSTACK_PUBLIC_KEY=pk_test_your_paystack_public
FLUTTERWAVE_SECRET_KEY=FLWSECK_TEST-your_key
FLUTTERWAVE_WEBHOOK_SECRET=your_flutterwave_webhook_secret
NEXT_PUBLIC_FLUTTERWAVE_PUBLIC_KEY=FLWPUBK_TEST-your_key

# --- Observability & Telemetry ---
SENTRY_DSN=https://your_sentry_dsn@sentry.io/project
NEXT_PUBLIC_SENTRY_DSN=https://your_sentry_dsn@sentry.io/project
NEXT_PUBLIC_POSTHOG_KEY=phc_your_posthog_key
NEXT_PUBLIC_POSTHOG_HOST=https://us.i.posthog.com
